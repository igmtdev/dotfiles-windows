# Shell
command = pwsh

# Colors
theme = Vesper

# Fonts
font-family = JetBrains Mono
font-size = 16
font-feature = -liga

# Application
confirm-close-surface = false

# Window
background-opacity = 0.8
window-padding-y = 12
window-padding-x = 12

# Cursor
cursor-style = bar

# Mouse
mouse-hide-while-typing = true

# Keybinds
keybind = super+shift+r=reload_config
